#!/usr/bin/env bash
ART=$(gum style --margin "0 0 0 7" "$(eye)")
INFO=$(wystem)
COLOR=$(gbc)

USER_INFO_LEN=$((${#HOSTNAME} + ${#USER} + 1))
USER_INFO=$(echo -e "\e[33m${USER}\e[97m@\e[36m${HOSTNAME}\e[37m")
USER_INFO_UNDERLINE=$(printf "%0.s▔" $(seq 1 $USER_INFO_LEN))

RIGHT=$(gum style \
  --margin "0 0 0 2" \
  --align center "\
${USER_INFO}
${USER_INFO_UNDERLINE}
${INFO}
${COLOR}")

OUT=$(gum join --vertical "${ART}" "${RIGHT}")

gum style --align center --padding "0 0 1 0" "${OUT}"

exit 0
